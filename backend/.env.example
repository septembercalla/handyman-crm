# PostgreSQL connection string.
# Railway: Postgres service -> Variables -> DATABASE_URL (copy the public URL for
# local work). Both postgres:// and postgresql:// are accepted — the driver
# suffix is added automatically.
DATABASE_URL=postgresql://postgres:password@host:5432/railway

# Sign JWTs with this. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# Server-side geocoding of task addresses. Leave empty and tasks are saved
# without coordinates (the UI shows a warning on the task record).
GOOGLE_MAPS_API_KEY=

# Comma-separated origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:3000

PORT=8000
ENV=development
