# PostgreSQL connection string.
# Railway: Postgres service -> Variables -> DATABASE_URL (copy the public URL for
# local work). Both postgres:// and postgresql:// are accepted — the driver
# suffix is added automatically.
DATABASE_URL=postgresql://postgres:password@host:5432/railway

# Sign JWTs with this. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# Server-only key for Geocoding API and Routes API. Never expose this key in
# NEXT_PUBLIC_* variables. GOOGLE_MAPS_API_KEY remains a backwards-compatible
# fallback, but new deployments should use the dedicated variable below.
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_MAPS_API_KEY=

# IANA timezone for payroll week boundaries and displayed completion dates.
BUSINESS_TIMEZONE=America/Chicago

# Private handyman documents. Local storage is for development only and must
# never be exposed as a static/public directory. Use r2 in production,
# with a private bucket and S3 API credentials.
FILE_STORAGE_BACKEND=local
FILE_STORAGE_LOCAL_PATH=.private-storage
FILE_STORAGE_MAX_MB=10

R2_BUCKET_NAME=
# S3 API endpoint, e.g. https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Comma-separated origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:3000

PORT=8000
ENV=development
